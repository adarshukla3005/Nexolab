# ── Postgres ────────────────────────────────────────────────────────
# In docker-compose this resolves to the `postgres` service.
DATABASE_URL=postgresql://dlc:dlc@postgres:5432/dlc

# ── Sessions ────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=change_me_32_byte_hex_secret

# ── Magic-link email (nodemailer DSN) ───────────────────────────────
# For local dev, docker-compose ships mailhog on smtp://mailhog:1025.
SMTP_URL=smtp://mailhog:1025
PUBLIC_BASE_URL=http://localhost:3001

# ── Git token ───────────────────────────────────────────────────────
# GitHub PAT (fine-grained, scope: contents/read+write on the target repo)
# or GitLab token with `write_repository`.
# Used ONLY via GIT_ASKPASS — never appears in argv, logs, or committed config.
GIT_TOKEN=ghp_replace_me

# ── LLM provider ────────────────────────────────────────────────────
# Point this at any OpenAI-compatible endpoint.
#
# Option A — Direct Anthropic API (recommended for public deployment):
#   LITELLM_BASE_URL=https://api.anthropic.com/v1/
#   LITELLM_MODEL=claude-sonnet-4-5-20250929
#
# Option B — A LiteLLM proxy you control:
#   LITELLM_BASE_URL=https://your-litellm.example.com
#   LITELLM_MODEL=claude-sonnet-4-6
LITELLM_BASE_URL=https://api.anthropic.com/v1/
LITELLM_API_KEY=sk-ant-replace_me
LITELLM_MODEL=claude-sonnet-4-5-20250929

# ── Reviewer mode ───────────────────────────────────────────────────
# `stub` skips the LLM review gate (fast, cheap). `real` runs a full review pass.
REVIEWER_MODE=stub

# ── Node env ────────────────────────────────────────────────────────
NODE_ENV=development
